// Copy to Config/Local.xcconfig (git-ignored) and fill in your own values.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
// Bundle identifiers are unique across Apple, so pick your own (e.g. com.<yourname>.SamsungRemote).
PRODUCT_BUNDLE_IDENTIFIER = org.example.SamsungRemote

// Multicast (SSDP discovery, broadcast Wake-on-LAN) is on by default and needs the multicast networking
// entitlement, which Apple grants per team on request. Without it, uncomment this to build for a device:
// SAMSUNG_REMOTE_MULTICAST = NO
