// Shared build settings for all FreeRemote targets.
// Owner-specific signing values live in the git-ignored Local.xcconfig (see Local.example.xcconfig),
// included at the end so they override these defaults.

PRODUCT_BUNDLE_IDENTIFIER = org.example.FreeRemote
IPHONEOS_DEPLOYMENT_TARGET = 27.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6
SWIFT_STRICT_CONCURRENCY = complete

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// YES only once Apple has granted your team the multicast networking entitlement
// (com.apple.developer.networking.multicast). It picks the entitlements file and tells the app, via
// FRMulticastEnabled in Info.plist, to use SSDP discovery and broadcast Wake-on-LAN. Set it in
// Local.xcconfig, never here.
FREE_REMOTE_MULTICAST = NO
FREE_REMOTE_ENTITLEMENTS_NO = App/FreeRemote/FreeRemote.entitlements
FREE_REMOTE_ENTITLEMENTS_YES = App/FreeRemote/FreeRemote+Multicast.entitlements
FREE_REMOTE_ENTITLEMENTS = $(FREE_REMOTE_ENTITLEMENTS_$(FREE_REMOTE_MULTICAST))

#include? "Local.xcconfig"
